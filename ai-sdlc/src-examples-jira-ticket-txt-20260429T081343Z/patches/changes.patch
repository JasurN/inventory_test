+import express from "express";
+import { NotificationTemplateController } from "../controllers/notificationTemplate.controller";
+import { NotificationTemplateService } from "../services/notificationTemplate.service";
+import { NotificationTemplateRepository } from "../repositories/notificationTemplate.repository";
+
+const router = express.Router();
+
+const repo = new NotificationTemplateRepository();
+const service = new NotificationTemplateService(repo);
+const controller = new NotificationTemplateController(service);
+
+// Middleware for admin authorization assumed to be applied globally or here
+
+router.get("/notification-templates", (req, res) => controller.list(req, res));
+router.post("/notification-templates", (req, res) => controller.create(req, res));
+router.put("/notification-templates/:id", (req, res) => controller.update(req, res));
+router.patch("/notification-templates/:id/deactivate", (req, res) =>
+  controller.deactivate(req, res)
+);
+
+export default router;
+
