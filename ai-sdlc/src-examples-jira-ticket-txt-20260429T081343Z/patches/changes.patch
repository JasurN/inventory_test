+  templates,
+  onEdit,
+  onDeactivate,
+}: Props) {
+  return (
+    <table aria-label="Notification Templates List" role="grid">
+      <thead>
+        <tr>
+          <th>Name</th>
+          <th>Channel</th>
+          <th>Status</th>
+          <th>Subject</th>
+          <th>Actions</th>
