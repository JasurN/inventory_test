+import {
+  NotificationTemplateDTO,
+  CreateNotificationTemplateDTO,
+  UpdateNotificationTemplateDTO,
+} from "../dtos/notificationTemplate.dto";
+
+// This is a stub repository. Replace with actual DB calls.
+export class NotificationTemplateRepository {
+  private templates: NotificationTemplateDTO[] = [];
+
+  async findAll(): Promise<NotificationTemplateDTO[]> {
+    // Return all templates
+    return this.templates;
+  }
+
+  async findById(id: string): Promise<NotificationTemplateDTO | null> {
+    const found = this.templates.find((t) => t.id === id);
+    return found ?? null;
+  }
+
+  async create(dto: CreateNotificationTemplateDTO): Promise<NotificationTemplateDTO> {
+    const now = new Date().toISOString();
+    const newTemplate: NotificationTemplateDTO = {
+      id: this.generateId(),
+      ...dto,
+      createdAt: now,
+      updatedAt: now,
+    };
+    this.templates.push(newTemplate);
+    return newTemplate;
+  }
+
+  async update(
+    id: string,
+    dto: UpdateNotificationTemplateDTO
+  ): Promise<NotificationTemplateDTO> {
+    const index = this.templates.findIndex((t) => t.id === id);
+    if (index === -1) throw new Error("NotFound");
+    const existing = this.templates[index];
+    const updated: NotificationTemplateDTO = {
+      ...existing,
+      ...dto,
+      updatedAt: new Date().toISOString(),
+    };
+    this.templates[index] = updated;
+    return updated;
+  }
+
+  private generateId(): string {
+    // Simple UUID v4 stub; replace with real UUID generator
+    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
+      const r = (Math.random() * 16) | 0,
+        v = c === "x" ? r : (r & 0x3) | 0x8;
+      return v.toString(16);
+    });
+  }
+}
+
